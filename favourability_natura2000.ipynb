   "source": [
    "\n",
    "# 3. Filtro de las 4 clases de favorabilidad\n",
    "clases_interes = ['alta', 'intermedia alta', 'intermedia baja', 'baja']  # Define las 4 clases a considerar\n",
    "fav_sel = fav[fav['Fav_clas'].isin(clases_interes)].copy()  # Mantiene solo las filas con esas clases\n",
    "\n",
    "# 4. Cálculo de porcentajes de superficie por clase de favorabilidad \n",
    "\n",
    "def calcular_porcentajes(capa_espacial, nombre_capa):\n",
    "    # Intersecta la capa espacial con la capa de favorabilidad\n",
    "    interseccion = gpd.overlay(\n",
    "        capa_espacial[['geometry']].copy(),  # Usa solo la geometría de la capa espacial\n",
    "        fav_sel[['Fav_clas', 'geometry']].copy(),  # Usa la geometría y la clase de favorabilidad\n",
    "        how='intersection',\n",
    "        keep_geom_type=False\n",
    "    )  # Genera la intersección para poder medir áreas por clase\n",
    "\n",
    "    interseccion['area_m2'] = interseccion.geometry.area  # Calcula el área de cada resultado de la intersección\n",
    "\n",
    "    # Superficie total de la capa espacial que se está analizando\n",
    "    total_area = capa_espacial.geometry.area.sum()  # Suma el área total de la capa espacial\n",
    "\n",
    "    resultados = {}\n",
    "    for clase in clases_interes:  # Recorre cada clase de favorabilidad\n",
    "        area_clase = interseccion.loc[interseccion['Fav_clas'] == clase, 'area_m2'].sum()  # Suma el área de esa clase\n",
    "        resultados[clase] = round(area_clase / total_area * 100, 2)  # Calcula y redondea el porcentaje\n",
    "\n",
    "    print(f\"{nombre_capa}:\")  # Muestra el nombre de la capa analizada\n",
    "    for clase, valor in resultados.items():  # Recorre cada resultado para imprimirlo\n",
    "        print(f\"  {clase}: {valor}%\")  # Muestra el porcentaje de cada clase\n",
    "\n",
    "    return resultados  # Devuelve el diccionario con los porcentajes\n",
    "\n",
    "\n",
    "# 5. Calcula los porcentajes para RN2K y ENP\n",
    "calcular_porcentajes(rn2k, 'RN2K')  # Ejecuta el cálculo para RN2K\n",
    "calcular_porcentajes(enp, 'ENP')  # Ejecuta el cálculo para ENP"
   ]
  }
