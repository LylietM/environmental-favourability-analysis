   "source": [
    "# 2. Definición de rutas y carga de capas\n",
    "\n",
    "base_dir = \".\"  # Define la carpeta actual como directorio base\n",
    "fav_path = os.path.join(base_dir, \"Fav.shp\")  # Ruta de la capa de favorabilidad\n",
    "rn2k_dis_path = os.path.join(base_dir, \"RN2K.shp\")  # Ruta de la capa RN2K\n",
    "enp_dis_path = os.path.join(base_dir, \"ENP.shp\")  # Ruta de la capa ENP\n",
    "\n",
    "# Comprueba que existen en la carpeta del notebook\n",
    "for ruta in [fav_path, rn2k_dis_path, enp_dis_path]:  # Recorre las tres rutas\n",
    "    if not os.path.exists(ruta):  # Comprueba si cada archivo existe\n",
    "        raise FileNotFoundError(f\"No se encontró la capa en: {ruta}\")  # Error si falta alguna capa\n",
    "\n",
    "# Carga las capas \n",
    "fav = gpd.read_file(fav_path)  # Lee la capa de favorabilidad\n",
    "rn2k = gpd.read_file(rn2k_dis_path)  # Lee la capa RN2K\n",
    "enp = gpd.read_file(enp_dis_path)  # Lee la capa ENP\n",
    "\n",
    "print('Capas cargadas')  # Confirma que las capas se han cargado\n",
    "print('Fav columnas:', fav.columns.tolist())  # Muestra las columnas de Fav\n",
    "print('RN2K columnas:', rn2k.columns.tolist())  # Muestra las columnas de RN2K\n",
    "print('ENP columnas:', enp.columns.tolist())  # Muestra las columnas de ENP\n",
    "\n",
    "# Comprobar CRS. Como está en EPSG:25830, no hace falta reproyectar\n",
    "print('CRS Fav:', fav.crs)  # Muestra el sistema de referencia de Fav\n",
    "print('CRS RN2K:', rn2k.crs)  # Muestra el sistema de referencia de RN2K\n",
    "print('CRS ENP:', enp.crs)  # Muestra el sistema de referencia de ENP\n",
    "\n",
    "# No hace falta reproyectar si ya están en EPSG:25830\n",
    "print('CRS ya está en EPSG:25830; no se reproyecta.')  # Informa que no es necesario reproyectar\n",
    "\n",
    "fav.head(6)  # Muestra las primeras filas de la tabla de Fav\n",
    "rn2k.head(6)  # Muestra las primeras filas de la tabla de RN2K\n",
    "enp.head(6)  # Muestra las primeras filas de la tabla de ENP\n"
   ]
